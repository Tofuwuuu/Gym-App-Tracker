# Runtime connection. On Neon, Prisma Postgres, or PgBouncer this is the pooled URL.
# For Prisma + PgBouncer transaction mode, include pgbouncer=true and connection_limit=1.
# Locally and in Docker Compose there is one database, so set this to that URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gymtracker?schema=public"

# Direct, unpooled connection used by `prisma migrate deploy` (schema directUrl).
# Neon: the non-pooler host, often exposed as DATABASE_URL_UNPOOLED. Copy that value here.
# Locally and in Docker Compose, set this to the same URL as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/gymtracker?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Public origin, no trailing slash. Local: http://localhost:3000
# Production: https://<your-domain>
AUTH_URL="http://localhost:3000"
# Legacy alias Auth.js still reads. Keep it identical to AUTH_URL.
NEXTAUTH_URL="http://localhost:3000"
# Trust the forwarded host (Docker, Vercel). The app also sets trustHost in code.
AUTH_TRUST_HOST="true"

# Optional Google OAuth. Leave both unset to hide the Google button.
# Callback URL: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Bearer token for GET /api/cron/reset-demo. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="generate-a-long-random-string"

# --- Docker Compose defaults (docker compose up --build) ---
# DATABASE_URL=postgresql://postgres:postgres@db:5432/gymtracker?schema=public
# DIRECT_URL=postgresql://postgres:postgres@db:5432/gymtracker?schema=public
# AUTH_SECRET=docker-dev-secret-change-me-in-production-32
# NEXTAUTH_URL=http://localhost:3000
# AUTH_URL=http://localhost:3000
